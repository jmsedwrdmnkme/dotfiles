#!/bin/sh

cover="${TMPDIR:-/tmp}/mpd_cover.jpg"

while :; do
  # Wait for a track change; retry while mpd is still starting at login.
  mpc idle player >/dev/null || { sleep 1; continue; }
  ffmpeg -y -loglevel quiet -i "$HOME/Music/$(mpc -f %file% current)" "$cover"
  dunstify -r 1 -i "$cover" "$(mpc current -f "[%title%\n][%artist%\n][%album% ][(%date%)]")"
done
