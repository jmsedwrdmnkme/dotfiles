#!/bin/sh

eval "$(xdotool getmouselocation --shell)"
colour=$(import -window root -depth 8 -crop "1x1+$X+$Y" txt:- | grep -om1 '#[0-9A-Fa-f]\{6\}')
printf '%s' "$colour" | xclip -i -selection clipboard
dunstify -h string:x-dunst-stack-tag:get-colour "Colour" "<span background=\"$colour\">  </span> $colour"
