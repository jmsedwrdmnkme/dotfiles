#!/bin/bash

bookmarks="$XDG_DATA_HOME/bookmarks/urls"

# Get user input with dmenu
choice=$(cat "$bookmarks" | dmenu -i -p "Search or Bookmark:")

# If nothing selected, exit
[ -z "$choice" ] && exit

# Check if choice is a URL (contains a top level domain and no whitespaces)
if [[ "$choice" =~ \.[a-zA-Z]{2,6} ]] && [[ ! "$choice" =~ [[:space:]] ]]; then
    # Open URL directly
    $BROWSER "$choice"
else
    # Treat as search query and open in DuckDuckGo
    query=$(echo "$choice" | sed 's/ /+/g')
    $BROWSER "https://duckduckgo.com/?q=$query"
fi
