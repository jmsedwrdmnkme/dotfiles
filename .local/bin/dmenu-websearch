#!/bin/bash

bookmarks="$XDG_DATA_HOME/bookmarks/urls" # Each line: "Name" url

choice=$(sed -E 's/.*"([^"]*)".*/\1/' "$bookmarks" | dmenu -i -p "Search or Bookmark:")
[ -z "$choice" ] && exit

choice_url=$(grep -F -m1 "\"$choice\"" "$bookmarks" | sed -E 's/"[^"]*"//g; s/^[[:space:]]+//; s/[[:space:]]+$//')

if [[ -n "$choice_url" ]]; then # Bookmark chosen
  query="$choice_url"
elif [[ "$choice" =~ \.[a-zA-Z]{2,6} && ! "$choice" =~ [[:space:]] ]]; then # Looks like a domain
  query="$choice"
else
  query="https://duckduckgo.com/?q=${choice// /+}"
fi

exec $BROWSER "$query"
