#!/bin/sh

[ -z "$1" ] && echo "usage: add-album-art IMAGE" >&2 && exit 1

[ -n "$(find . -name '*.flac' -print -quit)" ] &&
  find . -name '*.flac' \
    -exec metaflac --remove --block-type=PICTURE,PADDING --dont-use-padding {} + \
    -exec metaflac --import-picture-from="$1" {} + ||
  eyeD3 -r --add-image="$1":FRONT_COVER ./
