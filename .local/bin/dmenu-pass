#!/bin/sh

store="${PASSWORD_STORE_DIR:-$HOME/.local/share/password-store}"

# pick PROMPT: choose an entry from the password store via dmenu
pick() {
  find "$store/" -type f -name '*.gpg' -printf '%P\n' | sed 's|\.gpg$||' | sort | dmenu -i -p "$1"
}

while getopts upa arg; do
  case $arg in
    u) entry=$(pick "Username:") && [ -n "$entry" ] && pass show --clip=2 "$entry" && what=Username ;;
    p) entry=$(pick "Password:") && [ -n "$entry" ] && pass show --clip "$entry" && what=Password ;;
    a) entry=$(pick "OTP code:") && [ -n "$entry" ] && pass otp --clip "$entry" && what="OTP code" ;;
    *) continue ;;
  esac
  [ -n "$what" ] && notify-send "$what available in clipboard for the next 45 seconds"
  what=
done

[ "$OPTIND" -eq 1 ] && echo "Use with -u for username, -p for password, or -a for OTP"
