#!/bin/sh
# Run ncmpcpp with the current song's album art drawn by ueberzug in a blank
# column on the right of the playlist. Art comes from mpd itself (embedded
# picture first, then cover.jpg/folder.jpg etc. in the album directory).
#
# The art fills the full height of the playlist, with its width following the
# image's aspect ratio. The column reserved for it is sized at launch for a
# square cover; wider art is shrunk to fit that column.

[ -z "$DISPLAY" ] && exec /usr/bin/ncmpcpp "$@"

CACHE="${XDG_CACHE_HOME:-$HOME/.cache}/ncmpcpp-ueberzug-$$"
FIFO="$CACHE/fifo"
CONF="$CACHE/art.conf"

cleanup() {
  [ -n "$watcher" ] && pkill -P "$watcher" 2>/dev/null && kill "$watcher" 2>/dev/null
  exec 3>&-
  rm -rf "$CACHE"
}

# Prints "rows cols xpixel ypixel" for the terminal.
term_size() {
  python3 -I -c 'import fcntl, os, struct, termios
fd = os.open("/dev/tty", os.O_RDONLY)
print(*struct.unpack("HHHH", fcntl.ioctl(fd, termios.TIOCGWINSZ, bytes(8))))'
}

# Width in cells of an image IMG_W x IMG_H pixels drawn HEIGHT cells tall.
# Assumes cells are twice as tall as wide if the terminal doesn't report its
# pixel size.
art_width() { # HEIGHT IMG_W IMG_H
  term_size | awk -v h="$1" -v iw="$2" -v ih="$3" '{
    ratio = ($3 && $4) ? ($4 / $1) / ($3 / $2) : 2
    printf "%d\n", h * ratio * iw / ih + 0.5
  }'
}

# Full height minus the rows ncmpcpp's status and progress bars take.
art_height() {
  echo $(($(term_size | cut -d' ' -f1) - 2))
}

mkdir -p "$CACHE"
mkfifo "$FIFO"
ueberzug layer -s <"$FIFO" &
exec 3>"$FIFO"
trap cleanup EXIT
trap 'exit 1' INT TERM HUP

# Reserve room for a square cover at full height, but never more than half
# the terminal.
art_cols=$(art_width "$(art_height)" 1 1)
half=$(($(term_size | cut -d' ' -f2) / 2))
[ "$art_cols" -gt "$half" ] && art_cols=$half

# Overlay config: an empty fixed-width last column leaves room for the art.
cat >"$CONF" <<EOF
playlist_display_mode = columns
song_columns_list_format = "(30)[white]{t|f:Title} (7f)[magenta]{l} (6f)[green]{NE} (20)[blue]{a} (50)[cyan]{b} (5f)[yellow]{y} ($((art_cols + 2))f)[]{}"
header_visibility = no
titles_visibility = no
EOF

draw() {
  img=$(cat "$CACHE/current" 2>/dev/null)
  if [ -s "$img" ]; then
    height=$(art_height)
    dims=$(magick identify -format '%w %h' "$img[0]" 2>/dev/null) || dims="1 1"
    width=$(art_width "$height" $dims)
    [ "$width" -gt "$art_cols" ] && width=$art_cols
    cols=$(term_size | cut -d' ' -f2)
    printf '{"action":"add","identifier":"ncmpcpp","x":%d,"y":0,"width":%d,"height":%d,"scaler":"fit_contain","path":"%s"}\n' \
      "$((cols - width))" "$width" "$height" "$img" >&3
  else
    printf '{"action":"remove","identifier":"ncmpcpp"}\n' >&3
  fi
}

update() {
  uri=$(mpc current -f %file%)
  [ "$uri" = "$last" ] && return
  last="$uri"
  img=""
  if [ -n "$uri" ]; then
    img="$CACHE/$(printf %s "$uri" | md5sum | cut -c1-32)"
    [ -s "$img" ] || mpc readpicture "$uri" >"$img" 2>/dev/null
    [ -s "$img" ] || mpc albumart "$uri" >"$img" 2>/dev/null
  fi
  echo "$img" >"$CACHE/current"
  draw
}

# Redraw whenever the song changes.
(
  last=
  while :; do
    update
    mpc idle player >/dev/null 3>&- || break
  done
) &
watcher=$!

# Run ncmpcpp asynchronously so the WINCH trap can fire while it's running.
trap draw WINCH
/usr/bin/ncmpcpp -c "$HOME/.config/ncmpcpp/config" -c "$CONF" "$@" </dev/tty &
ncmpcpp_pid=$!
while kill -0 "$ncmpcpp_pid" 2>/dev/null; do
  wait "$ncmpcpp_pid"
done
