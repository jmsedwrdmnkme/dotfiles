#!/bin/bash

case "$BLOCK_BUTTON" in
  1) wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle ;;
  4) wpctl set-volume @DEFAULT_AUDIO_SINK@ 1%+ && pkill -RTMIN+5 "${STATUSBAR:-dwmblocks}" ;;
  5) wpctl set-volume @DEFAULT_AUDIO_SINK@ 1%- && pkill -RTMIN+5 "${STATUSBAR:-dwmblocks}" ;;
esac

# Stay quiet during the statusbar's initial run at login.
uptime=$(ps -o etimes= -p "$(pgrep -xo "${STATUSBAR:-dwmblocks}")" 2>/dev/null)
quiet="${XDG_RUNTIME_DIR:-/tmp}/status-volume-refresh"
if [[ -e "$quiet" ]]; then
  # The login refresh below: update the icon without a notification.
  rm -f "$quiet"
  silent=1
elif (( ${uptime:-99} <= 5 )); then
  silent=1
  # pipewire starts alongside the bar, so this first run can see the wrong
  # mute state. Refresh once the device is up and its state restored.
  (
    for _ in {1..60}; do
      wpctl get-volume @DEFAULT_AUDIO_SINK@ && break
      sleep 0.5
    done
    sleep 1
    touch "$quiet"
    pkill -RTMIN+5 "${STATUSBAR:-dwmblocks}"
  ) >/dev/null 2>&1 &
fi
notify() { [[ -z "$silent" ]] && dunstify "$@"; }

read -r _ level muted < <(wpctl get-volume @DEFAULT_AUDIO_SINK@)
vol=$(awk -v l="$level" 'BEGIN { printf "%d", l * 100 + 0.5 }')

if [[ -n "$muted" ]]; then
  icon="婢"
  notify -h string:x-dunst-stack-tag:volume "$icon Volume $vol% (Muted)"
else
  icon="墳"
  notify -h string:x-dunst-stack-tag:volume "$icon Volume $vol%"
fi

echo $icon
