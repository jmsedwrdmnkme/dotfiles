#!/bin/sh

ping -q -c 1 -W 2 example.org >/dev/null || exit

# If newsraft is open, ask it to reload instead of running a second instance
pgrep -f 'newsraft$' >/dev/null &&
  /usr/bin/xdotool key --window "$(/usr/bin/xdotool search --name '^newsraft$')" R && exit

pkill -RTMIN+2 "${STATUSBAR:-dwmblocks}"
/usr/bin/newsraft -e purge-abandoned >/dev/null
/usr/bin/newsraft -e reload-all >/dev/null
pkill -RTMIN+2 "${STATUSBAR:-dwmblocks}"
