#!/bin/sh

ping -q -c 1 -W 2 example.org >/dev/null || exit

pkill -RTMIN+9 "${STATUSBAR:-dwmblocks}"

dir="$HOME/.local/share/calcurse"
/usr/bin/calcurse-vdir -D "$dir" -f -v export "$dir/calendars" &&
  /usr/bin/vdirsyncer sync &&
  /usr/bin/calcurse-vdir -D "$dir" -f -v import "$dir/calendars"

pkill -RTMIN+9 "${STATUSBAR:-dwmblocks}"
