#!/bin/sh

# Only decrypt the password for actions that need sudo
sudo_run() {
  pass Password | sudo -S -p '' "$@"
}

choice=$(printf "lock\nlogout\nreboot\nshutdown" | dmenu -i -p "Do you want to:")

case "$choice" in
  lock) slock ;;
  logout) pkill xinit ;;
  reboot) sudo_run reboot ;;
  shutdown) sudo_run shutdown -h now ;;
esac
