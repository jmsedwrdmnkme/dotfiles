#!/bin/sh

xrdb "${XDG_CONFIG_HOME:-$HOME/.config}/x11/xresources" & xrdbpid=$!

# Run in order: read Caps Lock before it's remapped, and set the repeat rate
# after setxkbmap, which can reset it.
{
  xset -q | grep -q 'Caps Lock: *on' && xdotool key Caps_Lock
  setxkbmap -option caps:escape
  xset r rate 300 50
} &

feh --no-fehbg --bg-fill "$(cat "$HOME/.cache/wal/wal")" &

pipewire &
dwmblocks &
wpa_cli -a "$HOME/.local/bin/network-state" &
dunst &
syncthing serve --no-browser &
mpd &
mpdup &
calcurse --daemon
fcitx5 &

external-monitor &

wait "$xrdbpid"
