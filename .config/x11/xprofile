#!/bin/sh

external-monitor

xrdb "${XDG_CONFIG_HOME:-$HOME/.config}/x11/xresources" & xrdbpid=$!

{
  xset -q | grep -q 'Caps Lock: *on' && xdotool key Caps_Lock
  setxkbmap -option caps:escape
  xset r rate 300 50
  xset s off +dpms dpms 600 600 600
} &

feh --no-fehbg --bg-fill "$(cat "$HOME/.cache/wal/wal")" &

pipewire &
dwmblocks &
"$HOME/.local/bin/network-state" &
dunst &
xss-lock -- slock &
syncthing serve --no-browser &
mpd &
mpdup &
calcurse --daemon
fcitx5 &

wait "$xrdbpid"
