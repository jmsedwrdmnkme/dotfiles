#!/bin/sh

set -C -f
IFS="$(printf '%b_' '\n')"; IFS="${IFS%_}"

image() {
  if [ -f "$1" ] && [ -n "$DISPLAY" ] && [ -z "$WAYLAND_DISPLAY" ] && command -V ueberzug >/dev/null 2>&1; then
    printf '{"action": "add", "identifier": "PREVIEW", "x": "%s", "y": "%s", "width": "%s", "height": "%s", "scaler": "contain", "path": "%s"}\n' "$4" "$5" "$(($2-1))" "$(($3-1))" "$1" > "$FIFO_UEBERZUG"
  else
    mediainfo "$6"
  fi
}

# Render the first page of a document to PNG with LibreOffice: soffice_thumb <file> <out.png>
soffice_thumb() {
  OUTDIR="$(mktemp -d)"
  soffice -env:UserInstallation="file://${XDG_CACHE_HOME:-$HOME/.cache}/lf/soffice-profile" \
    --headless --convert-to png --outdir "$OUTDIR" "$1" >/dev/null 2>&1
  find "$OUTDIR" -name '*.png' -exec mv {} "$2" \;
  rm -rf "$OUTDIR"
}

case "$(file --dereference --brief --mime-type -- "$1")" in
  image/avif) CACHE="${XDG_CACHE_HOME:-$HOME/.cache}/lf/thumb.$(stat --printf '%n\0%i\0%F\0%s\0%W\0%Y' -- "$(readlink -f "$1")" | sha256sum | cut -d' ' -f1)"
    [ ! -f "$CACHE" ] && convert "$1" "$CACHE.jpg"
    image "$CACHE.jpg" "$2" "$3" "$4" "$5" "$1" ;;
  image/vnd.djvu)
    CACHE="${XDG_CACHE_HOME:-$HOME/.cache}/lf/thumb.$(stat --printf '%n\0%i\0%F\0%s\0%W\0%Y' -- "$(readlink -f "$1")" | sha256sum | cut -d' ' -f1)"
    [ ! -f "$CACHE" ] && djvused "$1" -e 'select 1; save-page-with /dev/stdout' | convert -density 200 - "$CACHE.jpg" > /dev/null 2>&1
    image "$CACHE.jpg" "$2" "$3" "$4" "$5" "$1" ;;
  image/svg+xml)
    CACHE="${XDG_CACHE_HOME:-$HOME/.cache}/lf/thumb.$(stat --printf '%n\0%i\0%F\0%s\0%W\0%Y' -- "$(readlink -f "$1")" | sha256sum | cut -d' ' -f1)"
    [ ! -f "$CACHE" ] && inkscape --convert-dpi-method=none -o "$CACHE.png" --export-overwrite -D --export-png-color-mode=RGBA_16 "$1"
    image "$CACHE.png" "$2" "$3" "$4" "$5" "$1"
    ;;
  image/*) image "$1" "$2" "$3" "$4" "$5" "$1" ;;
  text/html) lynx -width="$4" -display_charset=utf-8 -dump "$1" ;;
  text/troff) man ./ "$1" | col -b ;;
  text/* | */xml | application/json | application/x-ndjson) bat -p --theme ansi --terminal-width "$(($4-2))" -f "$1" ;;
  audio/* | application/octet-stream) mediainfo "$1" || exit 1 ;;
  video/* )
    CACHE="${XDG_CACHE_HOME:-$HOME/.cache}/lf/thumb.$(stat --printf '%n\0%i\0%F\0%s\0%W\0%Y' -- "$(readlink -f "$1")" | sha256sum | cut -d' ' -f1)"
    [ ! -f "$CACHE" ] && ffmpegthumbnailer -i "$1" -o "$CACHE" -s 0
    image "$CACHE" "$2" "$3" "$4" "$5" "$1"
    ;;
  */pdf)
    CACHE="${XDG_CACHE_HOME:-$HOME/.cache}/lf/thumb.$(stat --printf '%n\0%i\0%F\0%s\0%W\0%Y' -- "$(readlink -f "$1")" | sha256sum | cut -d' ' -f1)"
    if [ ! -f "$CACHE.jpg" ] && [ ! -f "$CACHE.png" ]; then
      if command -V pdftoppm >/dev/null 2>&1; then
        pdftoppm -jpeg -f 1 -singlefile "$1" "$CACHE"
      else
        soffice_thumb "$1" "$CACHE.png"
      fi
    fi
    [ -f "$CACHE.jpg" ] && image "$CACHE.jpg" "$2" "$3" "$4" "$5" "$1"
    [ -f "$CACHE.png" ] && image "$CACHE.png" "$2" "$3" "$4" "$5" "$1"
    ;;
  */epub+zip|*/mobi*)
    CACHE="${XDG_CACHE_HOME:-$HOME/.cache}/lf/thumb.$(stat --printf '%n\0%i\0%F\0%s\0%W\0%Y' -- "$(readlink -f "$1")" | sha256sum | cut -d' ' -f1)"
    [ ! -f "$CACHE.jpg" ] && gnome-epub-thumbnailer "$1" "$CACHE.jpg"
    image "$CACHE.jpg" "$2" "$3" "$4" "$5" "$1"
    ;;
  application/msword | application/rtf | text/rtf | application/vnd.ms-excel | application/vnd.ms-powerpoint | \
  application/vnd.openxmlformats-officedocument.* | application/vnd.oasis.opendocument.*)
    CACHE="${XDG_CACHE_HOME:-$HOME/.cache}/lf/thumb.$(stat --printf '%n\0%i\0%F\0%s\0%W\0%Y' -- "$(readlink -f "$1")" | sha256sum | cut -d' ' -f1)"
    [ ! -f "$CACHE.png" ] && soffice_thumb "$1" "$CACHE.png"
    [ -f "$CACHE.png" ] && image "$CACHE.png" "$2" "$3" "$4" "$5" "$1"
    ;;
  application/*zip) atool --list -- "$1" ;;
  *opendocument*) odt2txt "$1" ;;
  application/pgp-encrypted) gpg -d -- "$1" ;;
esac
exit 1
